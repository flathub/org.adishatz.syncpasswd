{
    "app-id" : "org.adishatz.syncpasswd",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [ "org.freedesktop.Sdk.Extension.llvm22" ],
    "command" : "syncpasswd",
    "build-options":{
        "append-path": "/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib"
    },
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.freedesktop.secrets",
        "--system-talk-name=org.freedesktop.NetworkManager",
        "--talk-name=org.gnome.keyring"
    ],
    "cleanup" : [
        "/bin/fxa-client",
        "/bin/ndptool",
        "/bin/nmcli",
        "/bin/nm-online",
        "/bin/normalizer",
        "/etc",
        "/include",
        "/lib/firewalld",
        "/lib/pkgconfig",
        "/lib/systemd",
        "/lib/udev",
        "/libexec",
        "/man",
        "/sbin",
        "/share/bash-completion",
        "/share/dbus-1",
        "/share/doc",
        "/share/gir-1.0",
        "/share/gtk-doc",
        "/share/man",
        "/share/mobile-broadband-provider-info",
        "/share/pkgconfig",
        "/share/polkit-1",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "libndp",
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "http://libndp.org/files/libndp-1.9.tar.gz",
                    "sha256" : "a8ab214e01dc3a9b615276905395637f391298c84d77651f0cbf0b1082dd2dd4"
                }
            ]
        },
        {
            "name" : "NetworkManager",
            "buildsystem" : "meson",
            "build-options" : {
                "cflags" : "-ltinfo",
                "cxxflags" : "-ltinfo"
            },
            "config-opts" : [
                "-Dlibaudit=no",
                "-Ddbus_conf_dir=/app/etc/dbus-1/system.d",
                "-Ddnsmasq=/usr/bin/true",
                "-Ddocs=false",
                "-Dintrospection=true",
                "-Diptables=/usr/bin/true",
                "-Dlibpsl=false",
                "-Dmodem_manager=false",
                "-Dnmtui=false",
                "-Dovs=false",
                "-Dppp=false",
                "-Dqt=false",
                "-Dselinux=false",
                "-Dsession_tracking=no",
                "-Dsystemd_journal=false",
                "-Dsystemdsystemunitdir=no",
		"-Dsystemdsystemgeneratordir=no",
		"-Dnbft=false",
                "-Dnm_cloud_setup=false",
		"-Dclat=false",
                "-Dtests=no",
                "-Dvapi=true"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/1.58.1/downloads/NetworkManager-1.58.1.tar.xz",
                    "sha256" : "262864cfd198123d3e5dbe91937441b97ee9059d6d712e1a5bfbb1c54668d14d"
                }
            ]
        },
        {
            "name" : "mobile-broadband-provider-info",
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/mobile-broadband-provider-info/20230416/mobile-broadband-provider-info-20230416.tar.xz",
                    "sha256": "e3e140aa2db769b299d1df86a890e948ab99d4d38831302c452d1fb7f8568aec"
                }
            ]
        },
        {
            "name" : "libnma",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dlibnma_gtk4=true",
                "-Dgtk_doc=false",
                "-Dintrospection=true",
                "-Dvapi=true"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/libnma/1.10/libnma-1.10.6.tar.xz",
                    "sha256": "53a6fb2b190ad37c5986caed3e98bede7c3c602399ee4f93c8fc054303d76dab"
                }
            ]
        },
        {
            "name" : "syncpasswd",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/gnumdk/syncpasswd.git",
                    "tag": "0.1.2",
                    "commit": "b82809dac26b38318a5ed42376efe0aeb8e9a223"
                }
            ]
        }
    ]
}
