{
    "app-id": "org.adishatz.syncpasswd",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "syncpasswd",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.freedesktop.secrets",
        "--system-talk-name=org.freedesktop.NetworkManager",
        "--talk-name=org.gnome.keyring"
    ],
    "modules": [
        {
            "name": "libndp",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "http://libndp.org/files/libndp-1.9.tar.gz",
                    "sha256": "a8ab214e01dc3a9b615276905395637f391298c84d77651f0cbf0b1082dd2dd4"
                }
            ]
        },
        {
            "name": "NetworkManager",
            "buildsystem": "meson",
            "build-options": {
                "cflags": "-ltinfo",
                "cxxflags": "-ltinfo"
            },
            "config-opts": [
                "-Dlibaudit=no",
                "-Ddbus_conf_dir=/app/etc/dbus-1/system.d",
                "-Ddnsmasq=/usr/bin/true",
                "-Ddocs=false",
                "-Dintrospection=true",
                "-Diptables=/usr/bin/true",
                "-Dlibpsl=false",
                "-Dmodem_manager=false",
                "-Dnmtui=false",
                "-Dovs=false",
                "-Dppp=false",
                "-Dqt=false",
                "-Dselinux=false",
                "-Dsession_tracking=no",
                "-Dsystemd_journal=false",
                "-Dsystemdsystemunitdir=no",
                "-Dnm_cloud_setup=false",
                "-Dtests=no",
                "-Dvapi=true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/NetworkManager/1.51/NetworkManager-1.51.4.tar.xz",
                    "sha256": "865a7cc5686a51d7efe81d7dcb3c5246bfa3b996a58629135354972804ff4d3c"
                }
            ]
        },
        {
            "name": "mobile-broadband-provider-info",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/mobile-broadband-provider-info/20230416/mobile-broadband-provider-info-20230416.tar.xz",
                    "sha256": "e3e140aa2db769b299d1df86a890e948ab99d4d38831302c452d1fb7f8568aec"
                }
            ]
        },
        {
            "name": "libnma",
            "buildsystem": "meson",
            "config-opts": [
                "-Dlibnma_gtk4=true",
                "-Dgtk_doc=false",
                "-Dintrospection=true",
                "-Dvapi=true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libnma/1.10/libnma-1.10.6.tar.xz",
                    "sha256": "53a6fb2b190ad37c5986caed3e98bede7c3c602399ee4f93c8fc054303d76dab"
                }
            ]
        },
        "python3-requirements.json",
        {
            "name": "syncpasswd",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/gnumdk/syncpasswd.git",
                    "tag": "0.1.1",
                    "commit": "ce979704b9147cadc89ccbd870151c70e767f195"
                }
            ]
        }
    ]
}
